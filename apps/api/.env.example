PORT=4000
API_HOST=127.0.0.1
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://orvia:orvia_local@localhost:5432/orvia?schema=public
WEB_PUBLIC_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Orvia <no-reply@localhost>
# Meta credentials are backend-only. Leave blank until the app and callback are configured.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=
META_REDIRECT_URI=
# Base64 encoding of a unique 32-byte key; do not reuse META_APP_SECRET.
META_TOKEN_ENCRYPTION_KEY=
REDIS_URL=redis://localhost:6379
