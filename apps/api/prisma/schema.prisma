generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String              @id @default(uuid()) @db.Uuid
  email          String              @unique @db.VarChar(320)
  passwordHash   String              @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime?          @map("email_verified_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile        ProfessionalProfile?
  sessions       Session[]
  authTokens     AuthToken[]
  diagnostics    Diagnostic[]
  strategies     Strategy[]
  metaOAuthAttempts MetaOAuthAttempt[]
  socialAccounts SocialAccount[]
  socialSyncRuns SocialSyncRun[]

  @@map("users")
}

model ProfessionalProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  professionalName  String?  @map("professional_name") @db.VarChar(160)
  profession        String?  @db.VarChar(120)
  specialty         String?  @db.VarChar(160)
  city              String?  @db.VarChar(120)
  region            String?  @db.VarChar(120)
  serviceMode       String?  @map("service_mode") @db.VarChar(40)
  targetAudience    String?  @map("target_audience") @db.Text
  professionalGoals String[] @default([]) @map("professional_goals")
  weeklyTimeMinutes Int?     @map("weekly_time_minutes")
  socialExperience  String?  @map("social_experience") @db.VarChar(40)
  postingFrequency  String?  @map("posting_frequency") @db.VarChar(40)
  communicationPreferences String[] @default([]) @map("communication_preferences")
  onboardingStep    Int      @default(0) @map("onboarding_step")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  timeZone          String   @default("America/Sao_Paulo") @map("time_zone") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([region, specialty])
  @@map("professional_profiles")
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  csrfHash String @map("csrf_hash") @db.VarChar(64)
  userId String @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  userAgent String? @map("user_agent") @db.VarChar(512)
  metaOAuthAttempts MetaOAuthAttempt[]
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([id, userId])
  @@index([userId, expiresAt])
  @@map("sessions")
}

model MetaOAuthAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  stateHash   String    @unique @map("state_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  pageDiscoveryTokenCiphertext String? @map("page_discovery_token_ciphertext") @db.Text
  pageDiscoveryScopes String[] @default([]) @map("page_discovery_scopes")
  pageDiscoveryExpiresAt DateTime? @map("page_discovery_expires_at") @db.Timestamptz(3)
  pageDiscoveryConsumedAt DateTime? @map("page_discovery_consumed_at") @db.Timestamptz(3)
  pageDiscoveryAttempts Int @default(0) @map("page_discovery_attempts")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session   @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([sessionId, expiresAt])
  @@index([userId, pageDiscoveryExpiresAt])
  @@map("meta_oauth_attempts")
}

model SocialAccount {
  id                    String          @id @default(uuid()) @db.Uuid
  userId                String          @map("user_id") @db.Uuid
  provider              String          @db.VarChar(40)
  providerAccountId     String          @map("provider_account_id") @db.VarChar(128)
  pageId                String          @map("page_id") @db.VarChar(128)
  pageName              String?         @map("page_name") @db.VarChar(255)
  username              String?         @db.VarChar(255)
  grantedScopes         String[]        @default([]) @map("granted_scopes")
  accessTokenCiphertext String?         @map("access_token_ciphertext") @db.Text
  tokenExpiresAt        DateTime?       @map("token_expires_at") @db.Timestamptz(3)
  status                String          @default("connected") @db.VarChar(32)
  connectedAt           DateTime        @default(now()) @map("connected_at") @db.Timestamptz(3)
  disconnectedAt        DateTime?       @map("disconnected_at") @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncRuns              SocialSyncRun[]

  @@unique([userId, provider, providerAccountId])
  @@unique([id, userId])
  @@index([userId, provider, status])
  @@map("social_accounts")
}

model SocialSyncRun {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  socialAccountId String?        @map("social_account_id") @db.Uuid
  provider        String         @db.VarChar(40)
  operation       String         @db.VarChar(64)
  status          String         @db.VarChar(24)
  startedAt       DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?      @map("finished_at") @db.Timestamptz(3)
  recordsRead     Int            @default(0) @map("records_read")
  errorCode       String?        @map("error_code") @db.VarChar(64)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount? @relation(fields: [socialAccountId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, provider, startedAt])
  @@index([socialAccountId, startedAt])
  @@map("social_sync_runs")
}

model AuthToken {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  userId String @map("user_id") @db.Uuid
  purpose String @db.VarChar(24)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, expiresAt])
  @@unique([userId, purpose])
  @@map("auth_tokens")
}

model RateLimitBucket {
  key String @id @db.VarChar(64)
  count Int @default(0)
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)
  @@map("rate_limit_buckets")
}

model Diagnostic {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  version          Int
  criteriaVersion  String   @map("criteria_version") @db.VarChar(40)
  profileSnapshot  Json     @map("profile_snapshot") @db.JsonB
  inputFingerprint String   @map("input_fingerprint") @db.VarChar(64)
  result           Json     @db.JsonB
  status           String   @default("current") @db.VarChar(20)
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy         Strategy?

  @@unique([id, userId])
  @@unique([userId, version])
  @@index([userId, status, createdAt])
  @@map("diagnostics")
}

model Strategy {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  diagnosticId String     @unique @map("diagnostic_id") @db.Uuid
  objective    String     @db.VarChar(500)
  plan         Json       @db.JsonB
  guardrails   Json       @db.JsonB
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnostic  Diagnostic @relation(fields: [diagnosticId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@unique([diagnosticId, userId])
  @@map("strategies")
}
