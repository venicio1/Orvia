# Server-to-server URL for health and authenticated NestJS API requests.
API_INTERNAL_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Orvia <no-reply@localhost>

# Local-only development values. Change these before using any shared environment.
DATABASE_URL=postgresql://orvia:orvia_local@localhost:5432/orvia?schema=public
API_HOST=127.0.0.1
TRUST_PROXY_HOPS=0
REDIS_URL=redis://localhost:6379
